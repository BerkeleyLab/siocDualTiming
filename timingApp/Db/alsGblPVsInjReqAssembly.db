#
# Records to asemble the injection request PV from
# single PVs.
#
# Mainly for compatibility with existing applications

record(longout, "$(T)TimTargetBucket") {
    field(DESC, "Bucket number")
    field(DRVH, "328")
    field(DRVL, "1")
    field(HOPR, "328")
    field(LOPR, "1")
    field(VAL, "1")
    field(PINI, "YES")
}

record(longout, "$(T)TimGunBunchCount") {
    field(DESC, "Number of gun bunches")
    field(DRVH, "16")
    field(DRVL, "1")
    field(HOPR, "16")
    field(LOPR, "1")
    field(VAL, "1")
    field(PINI, "YES")
}

record(mbbo, "$(T)TimInjMode") {
    field(DESC, "Injection Mode")
    field(OMSL, "supervisory")
    field(ZRST, "Default")
    field(ONST, "Linac Tuning")
    field(TWST, "BR Tuning")
    field(THST, "BTS Tuning")
    field(FRST, "SR Inj Prep")
    field(FVST, "SR Injection")
    field(SXST, "SR Tuning")
    field(ZRVL, "0")
    field(ONVL, "10")
    field(TWVL, "20")
    field(THVL, "30")
    field(FRVL, "41")
    field(FVVL, "40")
    field(SXVL, "42")
}

record(bo, "$(T)TimGunInhibit") {
    field(DESC, "Master Inhibit of Gun Trigger")
    field(ZNAM, "No Inhibit")
    field(ONAM, "Inhibit")
    field(OSV, "MAJOR")
    field(PINI, "YES")
    field(VAL, "0")
}

record(longout, "$(T)TimSequenceNumber") {
    field(DESC, "Sequence Number")
}

record(bo, "$(T)TimInjReqCommit") {
    field(DESC, "Fill TimInjReq waveform")
    field(FLNK, "$(T)TimInjReq:sub.PROC")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(HIGH, "1")
}

record(aSub, "$(T)TimInjReq:sub") {
    field(DESC, "Assembles pvs into request wf")
    field(SNAM, "assemble_injreq")
    field(LFLG, "IGNORE")
    field(INPA, "$(T)TimTargetBucket")
    field(INPB, "$(T)TimGunBunchCount")
    field(INPC, "$(T)TimInjMode.RVAL")
    field(INPD, "$(T)TimGunInhibit")
    field(INPE, "$(T)TimInjFieldSyncDelay")
    field(INPF, "$(T)TimExtrFieldSyncDelay")
    field(INPG, "$(T)TimSequenceNumber")
    field(FTA, "LONG")
    field(FTB, "LONG")
    field(FTC, "LONG")
    field(FTD, "LONG")
    field(FTE, "LONG")
    field(FTF, "LONG")
    field(FTG, "LONG")
    field(OUTA, "$(T)TimInjReq PP MS")
    field(FTVA, "DOUBLE")
    field(NOVA, "7")
}

# This will add the field to $(T)TimInjReq
# on alsGlbPVs Db file
record(waveform, "$(T)TimInjReq") {
    field(FLNK, "$(T)TimInjReqTime")
}

record(stringin, "$(T)TimInjReqTime") {
    field(DESC, "Time of last Injection Request")
    field(DTYP, "Soft Timestamp")
    field(INP, "@%b %d, %Y %H:%M:%S")
}

# This will add the field to $(T)GunBunchToInjFieldTrigger
# on alsGlbPVs Db file
record(waveform, $(T)GunBunchToInjFieldTrigger) {
    field(FLNK, "$(T)GunBunchDelayFromWF")
}

record(aSub, $(T)GunBunchDelayFromWF) {
    field(DESC, "Propogate GunBunchDelay WF to records")
    field(INPA, "$(T)TimGunBunchCount PP")
    field(INPB, "$(T)GunBunchToInjFieldTrigger PP")
    field(NOB, "16")
    field(SNAM, "gunbunchdelay_from_wf")
    field(OUTA, "$(T)GunBunchDelay PP")
    field(OUTB, "$(T)GunBunchDelay-1 PP")
    field(OUTC, "$(T)GunBunchDelay-2 PP")
    field(OUTD, "$(T)GunBunchDelay-3 PP")
    field(OUTE, "$(T)GunBunchDelay-4 PP")
    field(FTA, "LONG")
    field(FTB, "LONG")
    field(FTVA, "LONG")
    field(FTVB, "LONG")
    field(FTVC, "LONG")
    field(FTVD, "LONG")
    field(FTVE, "LONG")
}

record(aSub, $(T)GunBunchDelayToWF) {
    field(DESC, "Propogate GunBunchDelays to WF")
    field(INAM, "init_gunbunchdelays")
    field(INPA, "$(T)TimGunBunchCount PP")
    field(INPB, "$(T)GunBunchDelay PP")
    field(INPC, "$(T)GunBunchDelay-1 PP")
    field(INPD, "$(T)GunBunchDelay-2 PP")
    field(INPE, "$(T)GunBunchDelay-3 PP")
    field(INPF, "$(T)GunBunchDelay-4 PP")
    field(SNAM, "gunbunchdelay_to_wf")
    field(OUTA, "$(T)GunBunchToInjFieldTrigger PP")
    field(NOVA, "16")
    field(FTA, "LONG")
    field(FTB, "LONG")
    field(FTC, "LONG")
    field(FTD, "LONG")
    field(FTE, "LONG")
    field(FTF, "LONG")
    field(FTVA, "LONG")
}

record(ao, $(T)GunBunchDelay) {
    field(DESC, "Delay due to #Gun Bunches")
    field(EGU, "4*BROC")
    field(LINR, "SLOPE")
    field(ESLO, "0.008")
    field(FLNK, "$(T)GunBunchDelayToWF")
}

record(ao, $(T)GunBunchDelay-1) {
    field(DESC, "Delay when #Gun Bunches = 1")
    field(EGU, "4*BROC")
    field(LINR, "SLOPE")
    field(ESLO, "0.008")
    field(FLNK, "$(T)GunBunchDelayToWF")
}

record(ao, $(T)GunBunchDelay-2) {
    field(DESC, "Delay when #Gun Bunches = 2")
    field(EGU, "4*BROC")
    field(LINR, "SLOPE")
    field(ESLO, "0.008")
    field(FLNK, "$(T)GunBunchDelayToWF")
}

record(ao, $(T)GunBunchDelay-3) {
    field(DESC, "Delay when #Gun Bunches = 3")
    field(EGU, "4*BROC")
    field(LINR, "SLOPE")
    field(ESLO, "0.008")
    field(FLNK, "$(T)GunBunchDelayToWF")
}

record(ao, $(T)GunBunchDelay-4) {
    field(DESC, "Delay when #Gun Bunches = 4")
    field(EGU, "4*BROC")
    field(LINR, "SLOPE")
    field(ESLO, "0.008")
    field(FLNK, "$(T)GunBunchDelayToWF")
}

