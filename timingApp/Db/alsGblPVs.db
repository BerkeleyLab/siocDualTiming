record(ao, "$(T)TimCycleDelay") {
    field(DESC,"Additional delay for end of cycle")
    field(DRVH, "15")
    field(DRVL, "0")
    field(HOPR, "15")
    field(LOPR, "0")
    field(PINI, "YES")
    field(VAL,  "0")
    field(LINR, "LINEAR")
    field(ASLO, "8e-09")
    field(EGU,  "s")
    info(archive,"Slow")
}

record(ai, "$(T)TimInjFieldCounterFiltd") {
    field(DTYP, "Raw Soft Channel")
    field(INP, "irm:150:CounterValue CPP MS")
    field(SMOO, "0.9")
    info(archive,"Slow")
}

record(ai, "$(T)TimExtrFieldCounterFiltd") {
    field(DTYP, "Raw Soft Channel")
    field(INP, "irm:151:CounterValue CPP MS")
    field(SMOO, "0.9")
    info(archive,"Slow")
}

alias("$(P)$(R)INJ:tgtARBucket", "$(T)TimTargetARBucket")
alias("$(P)$(R)INJ:alignSel", "$(T)TimInjAlignSel")
alias("$(P)$(R)INJ:syncMode", "$(T)TimInjSyncMode")

# Injection Request Waveform: 7 elements meaning:
# 0: SR Bucket Number to target (1 to 328)
# 1: Number of Gun Bunches (1 to 16)
# 2: Injection Mode Number (sets enables for setup, injection, tuning modes)
# 3: Gun Inhibit (0: det. by Inj. Mode Number; 1: Disable the gun trigger)
# 4: AR Bucket Number to target (1 to 304)
# 5: Reserved for future use
# 6: Sequence Number (must change from last cycle to do anything but default cycle)
# This is to be used by the timing sequencer.
record(waveform, "$(T)TimInjReq") {
    field(DESC, "Injection Request Waveform")
    field(FTVL, "LONG")
    field(NELM, "7")
    field(FLNK, "$(T)TimInjReqRbk")
    info(archive,"Slow")
}

record(waveform, $(T)GunBunchToInjFieldTrigger) {
    field(DESC, "Injection Field Trigger Waveform")
    field(EGU, "125*EvtClkTicks")
    field(NELM, "16")
    field(FTVL, "DOUBLE")
    field(PINI, "YES")
    info(autosaveFields_pass0, "VAL")
}

record(bi, $(T)TimPotentate) {
    field(DESC, "Global timing enable/disable")
    field(VAL, "1")
    field(PINI, "YES")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    info(archive,"Slow")
}

# EVR IOC records.
# Injection cycles are initiated only when all are valid.
# FIXME: Should LI11:EVR:[12], CR:EVR1, and S0220:EVR1 also be checked?
record(calc, "$(T)TimAllEVRvalid") {
    field(INPA, "B0215:EVR1:Link-Sts MS CPP")
    field(INPB, "S0123:EVR1:Link-Sts MS CPP")
    field(INPC, "S0817:EVR1:Link-Sts MS CPP")
    field(CALC, "A&B&C")
    field(LOLO, "0")
    field(LLSV, "MAJOR")
}

# BR extraction calc. PVs
record(ai,"$(T)B0215:TimSeqRemainder") {
    info(archive,"Slow")
}

record(longin,"$(T)B0215:TimSeqFineDelay") {
    info(archive,"Slow")
}

record(longin,"$(T)B0215:TimSeqFineDelayOffst") {
    info(archive,"Slow")
}
