# This setpoint is assumed to contain the event delay, which is then
# subtracted below
#
record(longout, $(T)TimInjFieldSyncDelaySP) {
    field(DESC, "Inj Field Delay SP in 4 * BROC")
    field(DTYP, "Soft Channel")
    field(FLNK, "$(T)GaussClockInjectionFieldTrigger")
    field(EGU, "4*BROC")
}

record(longout, "$(T)TimInjFieldEventDelay") {
    field(DESC, "Fine adjustment to Sync Delay")
    field(DTYP, "Soft Channel")
    field(FLNK, "$(T)GaussClockInjectionFieldTrigger")
    field(EGU, "EvtClkTicks")
}

record(calc, "$(T)GaussClockInjectionFieldTrigger") {
    alias ("$(T)TimInjFieldSyncDelay")
    field(DESC, "Inj delay in ticks")
    field(INPA, "$(T)TimInjFieldSyncDelaySP")
    field(INPB, "125")
    field(INPC, "$(T)TimInjFieldEventDelay")
    field(CALC, "(A*B)-C")
    field(EGU, "EvtClkTicks")
}

#
# This setpoint is assumed to contain the event delay, which is then
# subtracted below
#
record(longout, $(T)TimExtrFieldSyncDelaySP) {
    field(DESC, "Extraction Field Dly in COIC cycles")
    field(DTYP, "Soft Channel")
    field(FLNK, "$(T)GaussClockExtractionFieldTrigger")
    field(EGU, "COIC cycles")
}

record(longout, "$(T)TimExtrFieldEventDelay") {
    field(DESC, "Fine adjustment to Sync Delay")
    field(DTYP, "Soft Channel")
    field(FLNK, "$(T)GaussClockExtractionFieldTrigger")
    field(EGU, "EvtClkTicks")
}

record(calc, "$(T)GaussClockExtractionFieldTrigger") {
    alias("$(T)TimExtrFieldSyncDelay")
    field(DESC, "ExtrInj delay in ticks")
    field(INPA, "$(T)TimExtrFieldSyncDelaySP")
    field(INPB, "10250")
    field(INPC, "$(T)TimExtrFieldEventDelay")
    field(CALC, "(A*B)-C")
    field(EGU, "EvtClkTicks")
}

record(ai, "$(T)TimInjFieldCounterFiltd") {
   field(DTYP, "Raw Soft Channel")
   field(INP, "irm:150:CounterValue CPP MS")
   field(SMOO, "0.9")
}

record(ai, "$(T)TimExtrFieldCounterFiltd") {
   field(DTYP, "Raw Soft Channel")
   field(INP, "irm:151:CounterValue CPP MS")
   field(SMOO, "0.9")
}

# Injection Request Waveform: 7 elements meaning:
# 0: SR Bucket Number to target (1 to 328)
# 1: Number of Gun Bunches (1 to 16)
# 2: Injection Mode Number (sets enables for setup, injection, tuning modes)
# 3: Gun Inhibit (0: det. by Inj. Mode Number; 1: Disable the gun trigger)
# 4: Reserved for future use
# 5: Reserved for future use
# 6: Sequence Number (must change from last cycle to do anything but default cycle)
# This is to be used by the timing sequencer.
record(waveform, "$(T)TimInjReq") {
       field(DESC, "Injection Request Waveform")
       field(FTVL, "LONG")
       field(NELM, "7")
}

# FIXME: Is this still (ever?) necessary?
