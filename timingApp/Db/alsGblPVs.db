#	field(DESC, "Gun Bias Waveform")
#	field(EGU, "V")
#	field(NELM, "16")
#	field(FTVL, "DOUBLE")
#}

record(waveform, $(T)GunBunchToInjFieldTrigger) {
    field(DESC, "Injection Field Trigger Waveform")
    field(EGU, "125*EvtClkTicks")
    field(NELM, "16")
    field(FTVL, "DOUBLE")
}

record(bi, $(T)TimPotentate) {
    field(DESC, "Global timing enable/disable")
    field(VAL, "1")
    field(PINI, "YES")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
}

# EVR IOC records.
# Injection cycles are initiated only when all are valid.
# FIXME: Should LI11:EVR:[12], CR:EVR1, and S0220:EVR1 also be checked?
record(calc, "$(T)TimAllEVRvalid") {
    field(INPA, "B0215:EVR1:Link-Sts MS CPP")
    field(INPB, "S0123:EVR1:Link-Sts MS CPP")
    field(INPC, "S0817:EVR1:Link-Sts MS CPP")
    field(CALC, "A&B&C")
    field(LOLO, "0")
    field(LLSV, "MAJOR")
}
