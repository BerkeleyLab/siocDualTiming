# Track production system
record(waveform, $(T)TimInjReq) {
    field(INP,  "$(PROD)TimInjReq CPP MS")
}
record(waveform, $(T)GunBunchToInjFieldTrigger) {
    field(INP,  "$(PROD)GunBunchToInjFieldTrigger CPP MS")
}
record(bi, $(T)TimPotentate) {
    field(INP,  "$(PROD)TimPotentate CPP MS")
}
record(longout, "$(P)$(R)INJ:singleShot") {
    field(OMSL, "closed_loop")
    field(DOL,  "$(OLD_EVG_INJ_START) CP MS")
}
record(bo, "$(P)$(R)INJ:injCycleEnable") {
    field(SIML, "YES")
    field(SIOL, "0")
}

